{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": [
    "src/index.{ts,tsx,js,jsx}",
    "src/main.{ts,tsx,js,jsx}"
  ],
  "workspaces": {
    "packages": [
      "packages/*"
    ]
  },
  "dynamicallyLoaded": [
    "**/tsdown.config.ts",
    "tsdown.base.config.mjs",
    "packages/vite/example/src/entry-client.tsx",
    "packages/vite/example/src/entry-server.tsx",
    "packages/vite/example/vite.config.ts"
  ],
  "ignorePatterns": [
    ".github/*",
    "packages/vite/example/public/**"
  ],
  "ignoreDependencies": [
    "bun"
  ],
  "duplicates": {
    "minOccurrences": 3
  },
  "rules": {
    "unused-dependencies": "warn"
  }
}
